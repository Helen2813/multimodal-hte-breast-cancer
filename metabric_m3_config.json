{
  "metabric_raw_dir": "data/raw/metabric",
  "metabric_m2_dir": "results/tables/metabric_m2",
  "output_dir": "results/tables/metabric_m3",
  "search_roots": [
    "data",
    "results"
  ],
  "exclude_path_tokens": [
