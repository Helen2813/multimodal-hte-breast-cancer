  "metabric_files": {
    "rna": "data_mrna_illumina_microarray.txt",
    "cna": "data_cna.txt",
    "methylation": "data_methylation_promoters_rrbs.txt",
    "mutations": "data_mutations.txt"
  },
  "required_tcga_modalities_for_m4": [
    "clinical",
    "rna",
    "cna",
    "mutations"
